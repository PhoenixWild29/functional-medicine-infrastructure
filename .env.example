# ============================================================
# CompoundIQ Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
#
# Vercel environments: production | preview | development
# Set each variable in the Vercel dashboard per environment.
# ============================================================

# ------------------------------------------------------------
# DATABASE — Supabase
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Client-side Supabase vars (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ------------------------------------------------------------
# STRIPE
# ------------------------------------------------------------
# Production: sk_live_xxx / pk_live_xxx
# Staging/Dev: sk_test_xxx / pk_test_xxx
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Found in: Stripe Dashboard → Developers → Webhooks → endpoint signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ------------------------------------------------------------
# TWILIO — SMS
# ------------------------------------------------------------
# Found in: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN is also used to validate inbound webhook signatures
# at /api/sms/callback via Twilio's X-Twilio-Signature header verification
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550000000
# Optional: API Key signing secret (Twilio Console → API Keys)
# Used if you prefer API Key auth over Auth Token for webhook validation
TWILIO_WEBHOOK_SECRET=your-twilio-webhook-secret

# ------------------------------------------------------------
# DOCUMO — Fax
# ------------------------------------------------------------
# Found in: Documo Dashboard → API Settings
DOCUMO_API_KEY=your-documo-api-key
DOCUMO_ACCOUNT_ID=your-documo-account-id
DOCUMO_OUTBOUND_FAX_NUMBER=+15550000001
DOCUMO_WEBHOOK_SECRET=your-documo-webhook-secret

# ------------------------------------------------------------
# AUTH
# ------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-jwt-secret-minimum-32-chars
# Checkout token expiry in seconds (72h = 259200)
CHECKOUT_TOKEN_EXPIRY=259200

# ------------------------------------------------------------
# ERROR MONITORING — Sentry
# ------------------------------------------------------------
# Found in: Sentry Dashboard → Project Settings → Client Keys
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Found in: Sentry Dashboard → Organization Settings → General
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=compoundiq

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
# Public base URL of the deployed app — used for webhook callback URLs and SMS links
APP_BASE_URL=https://your-app.vercel.app

# ------------------------------------------------------------
# ALERTING — Slack & PagerDuty
# ------------------------------------------------------------
# Found in: Slack → App settings → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Found in: Slack → App settings → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Found in: Slack → App settings → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_OPS_ALERTS_CHANNEL_ID=C0000000000
# Slack user ID of the on-call ops manager (for DM escalations)
SLACK_OPS_MANAGER_USER_ID=U0000000000
# Found in: PagerDuty → Services → Integration key
PAGERDUTY_ROUTING_KEY=your-pagerduty-routing-key

# ------------------------------------------------------------
# PHARMACY ADAPTER
# ------------------------------------------------------------
# Timeout for adapter API calls in milliseconds
ADAPTER_TIMEOUT_MS=30000
# Max retry attempts before marking submission as FAILED
RETRY_MAX_ATTEMPTS=3
# Failure threshold before circuit breaker opens (0.0 - 1.0)
CIRCUIT_BREAKER_THRESHOLD=0.5
# Run Playwright in headless mode (true in production/staging)
PLAYWRIGHT_HEADLESS=true

# ------------------------------------------------------------
# POC FEATURE FLAGS
# ------------------------------------------------------------
# Set to false in POC environments to suppress live SMS/fax dispatch.
# Messages are logged to console instead — checkout tokens are still visible.
TWILIO_ENABLED=true
DOCUMO_ENABLED=true
# Kill switch for everything sent to a pharmacy (Tier 1 API, Tier 2 portal,
# Tier 4 fax via Documo). OFF unless exactly "true": paid orders wait in
# PAID_PROCESSING and ops resubmit actions answer 423. Owner turns it on.
PHARMACY_SUBMISSIONS_ENABLED=false
# Retention switch (compliance C10). OFF unless exactly "true": retention
# jobs only count. /api/cron/retention records dry runs in retention_runs;
# screenshot-cleanup reports what it would delete and removes nothing. No
# /api/cron/retention policy is live yet, so turning this on deletes only
# portal screenshots older than 72 hours.
RETENTION_ENABLED=false

# ------------------------------------------------------------
# SIGN-IN SECURITY (compliance C3)
# ------------------------------------------------------------
# Multi-factor sign-in for provider, medical_assistant, clinic_admin and
# ops_admin. OFF unless exactly 'true'. When on, every staff user enrolls
# a TOTP factor on first sign-in and enters a code on every new sign-in;
# pages and APIs need AAL2. Users can still enroll from Settings when off.
REQUIRE_MFA=false
# Comma-separated emails to enforce MFA for even when REQUIRE_MFA is off
# (E2E sets the dedicated test-mfa-admin account here). Usually empty.
MFA_ENFORCED_EMAILS=
# HIPAA automatic logoff: minutes of inactivity before sign-out (default 15).
IDLE_TIMEOUT_MINUTES=15

# ------------------------------------------------------------
# POC SEED DATA
# ------------------------------------------------------------
# Stripe Connect Express account ID for the POC test clinic (acct_xxx).
# Created in WO-53 Stripe setup. Required by scripts/seed-poc.ts.
STRIPE_CONNECT_TEST_ACCOUNT_ID=acct_your-test-connect-account-id

# ------------------------------------------------------------
# ONBOARDING, AUDIT AND AI (October 2026)
# ------------------------------------------------------------
# Ops approval gives a clinic with no Stripe Connect account a demo payout
# placeholder (poc_placeholder_<clinic_id>, ACTIVE) so ordering opens on
# approval. On unless exactly "false" (src/lib/clinics/demo-payouts.ts).
DEMO_PAYOUTS_ON_APPROVAL=true
# Key for the HMAC of email, IP and user agent in phi_access_log and
# epcs_audit_log. Without it those hashes are left empty. Set in production.
PHI_ACCESS_LOG_HASH_SECRET=replace-with-a-long-random-secret
# Face-sheet fill on New patient (src/lib/face-sheet/config.ts). Without a
# key the feature is not shown at all. FACE_SHEET_AI_ENABLED=false turns it
# off even with a key; ANTHROPIC_MODEL overrides the default model.
ANTHROPIC_API_KEY=
FACE_SHEET_AI_ENABLED=true
# ANTHROPIC_MODEL=
# ------------------------------------------------------------
# NEXT.JS
# ------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=development

# ── POC demo and E2E account passwords (security B9) ─────────
# Never committed: set them in your local env. The seed script
# (npm run seed:poc) and the ops Reset Demo Credentials button stop with
# an error naming any that are missing.
POC_OPS_PASSWORD=
POC_CLINIC_ADMIN_PASSWORD=
POC_PROVIDER_PASSWORD=
POC_MA_PASSWORD=
# E2E accounts (e2e/fixtures/test-password.ts). Optional: when empty the
# password is derived from E2E_SUPABASE_SERVICE_ROLE_KEY.
E2E_TEST_PASSWORD=

# ── Support contact (decision 12) ────────────────────────────
# The address Help and every "Contact CompoundIQ" line name, per
# environment (production and the demo point to their own inbox).
# Empty or not an email address: the generic "Contact CompoundIQ".
NEXT_PUBLIC_SUPPORT_EMAIL=
